//7.4 (leuke opdracht)

int dagVanDeWeek = 5;

switch(dagVanDeWeek){
  case 1:
  println("Maandag");
  break;
  case 2:
  println("Dinsdag");
  break;
  case 3:
  println("Woensdag");
  break;
  case 4:
  println("Donderdag");
  break;
  case 5:
  println("Vrijdag (beste dag)");
  break;
  case 6:
  println("Zaterdag (tweede beste dag van de week)");
  break;
  case 7:
  println("Zondag");
  break;
  default:
  println("Geen dag van de week");
  break;
}
